#!/usr/bin/env bash
# Keep the LKs agent project board (github.com/orgs/hoopit/projects/2) filled to its
# caps, dispatching a herdr agent per free slot as slots free.
#
# There is no model in this loop: `hoopit-board next` picks, and its docstring is the
# account of how. This script claims what it returns and starts an agent on it, and the
# agent runs `/assess-issue`, which reads the issue and decides what to do. So nothing
# here understands the work — only that two agents must not share a file or a migration
# graph, which `next` establishes from resolved paths and, where an issue names none, from
# a System One judgement over its prose. A candidate that judgement leaves uncertain comes
# back under `needs_judgement`, is never dispatched from here, and is settled by
# `gh-triage` step 2.
#
# Judgement that needs a human is the `gh-triage` skill, and the items no agent can
# finish — Autonomy `Needs decision` or `Out of reach` — are never started here at all;
# `hoopit-board decisions` is the queue for clearing those by hand.
#
# --max-active caps what an agent is still working — `In progress` and `AI review` — and
# frees a slot when a PR goes ready, an assessment closes its issue, or an agent hands it
# back, so agents start in waves as the earlier ones settle rather than all at once.
# --max-review holds every start while `Human review` is that full, so the daemon idles
# until something merges; work active when it closes still lands, and the queue can reach
# --max-review + --max-active - 1. <target> caps all of flight, `Human review` included,
# for a review queue that must never pass a number. One tick fills every slot the caps
# leave free.
#
# Owning work and working it are separate facts. The board status is the ownership: an
# item in flight is never offered again, and its open PR holds its files. Its place
# under --max-active it keeps only while its agent is at work. One whose agent is gone,
# or has sat silent past the quiet window — stopped on a question nobody is there to
# answer — is logged as `quiet` and its place goes to the next candidate. Nothing is
# released or closed for it, and it counts again the tick its agent moves.
#
#   start-backlog-daemon [<target>] [--max-active N] [--max-review M]
#                        [--interval SEC] [--once] [--dry-run]
#
# An agent working one of these repos reaches AWS, so a dead `aws login` session turns a
# start into a run that fails late, with the slot claimed and the tab already open. Each
# tick proves the session with one call before anything starts, and a dead one holds the
# whole tick and raises a desktop notification. Nothing is released or closed while it
# holds; the daemon dispatches again by itself once `aws login --profile login-raw` runs.
#
# Settings come from ~/.config/start-backlog.env, so a run from a terminal and the
# service behave alike. A variable already in the environment beats the file, and a flag
# beats both.
#
# Installed as ~/.config/systemd/user/start-backlog.service;
# journalctl --user -u start-backlog -f has the whole run.

set -uo pipefail

# The file is a systemd EnvironmentFile — unquoted values with spaces in them — so it is
# read as KEY=VALUE lines and never sourced.
ENV_FILE=${START_BACKLOG_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/start-backlog.env}
if [[ -r "$ENV_FILE" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^(START_BACKLOG_[A-Z_]+)=(.*)$ ]] || continue
    [[ -v "${BASH_REMATCH[1]}" ]] || export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
  done < "$ENV_FILE"
fi
# START_BACKLOG_FLAGS goes first, so a flag typed on the command line wins.
# shellcheck disable=SC2086
set -- ${START_BACKLOG_FLAGS:-} "$@"

TARGET=${START_BACKLOG_TARGET:-}
# An empty cap is one not applied.
MAX_ACTIVE=${START_BACKLOG_MAX_ACTIVE:-}
MAX_REVIEW=${START_BACKLOG_MAX_REVIEW:-}
INTERVAL=600
ONCE=0
DRY=0
# A candidate this daemon dispatched inside the cooloff is passed over. A reaped item
# goes back to Ready and `check` reads the release as cancelling the claim, so without
# this the same item redispatches every tick. (An agent that hands back with a question
# parks its issue in Backlog, where only the user's promotion offers it again.)
COOLOFF_HOURS=${START_BACKLOG_COOLOFF_HOURS:-6}
# In progress this long with no open PR, and its herdr agent gone, means a dead agent
# holding a slot nothing will ever free.
STALE_HOURS=${START_BACKLOG_STALE_HOURS:-1}
# An agent herdr does not report `working`, whose session transcript has not moved for
# this long, is not at work.
QUIET_MINUTES=${START_BACKLOG_QUIET_MINUTES:-60}
REPOS_DIR=${START_BACKLOG_REPOS_DIR:-$HOME/Dev/Hoopit}
# The repos this daemon fills: the caps count flight in these alone, and work starts
# nowhere else. The board also tracks tooling repos, and an unattended agent there
# rewrites the skills every other agent is running on.
REPOS=${START_BACKLOG_REPOS:-hoopit/api hoopit/web-admin hoopit/flutter-app}
# 0 for a board whose work never touches AWS.
AWS_CHECK=${START_BACKLOG_AWS_CHECK:-1}
# How long between notifications while the session stays dead. The log says so every tick.
AWS_ALERT_REPEAT_MINUTES=${START_BACKLOG_AWS_ALERT_REPEAT_MINUTES:-60}

while [[ $# -gt 0 ]]; do
  case "$1" in
    # Kept so an older invocation or env file still starts. Unattended-only is what
    # `hoopit-board next` does unconditionally now.
    --unattended) echo "note: --unattended is the only behaviour; the flag is redundant"; shift ;;
    --max-active) MAX_ACTIVE="$2"; shift 2 ;;
    --max-review) MAX_REVIEW="$2"; shift 2 ;;
    --interval) INTERVAL="$2"; shift 2 ;;
    --once) ONCE=1; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) TARGET="$1"; shift ;;
  esac
done
# --max-review holds starts and bounds none, so one of the other two must be there.
[[ -n "$TARGET$MAX_ACTIVE" ]] || { echo "usage: start-backlog-daemon [<target>] [--max-active N] [--max-review M] [--interval SEC] [--once] [--dry-run] — give <target> or --max-active" >&2; exit 2; }

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/start-backlog"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/start-backlog"
DISPATCHED="$STATE_DIR/dispatched.tsv"   # <repo#n>\t<epoch>, one dispatch per line
LOCK="$RUN_DIR/dispatch.lock"
AWS_ALERT_STAMP="$STATE_DIR/aws-alerted"   # epoch of the last notification; absent when healthy
mkdir -p "$STATE_DIR" "$RUN_DIR"
touch "$DISPATCHED"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }
jqr() { python3 -c "import json,sys; print(eval(sys.argv[1], {'d': json.load(sys.stdin)}))" "$1"; }

# The client talks to the herdr server over a socket and does not care whether the
# caller sits in a managed pane, so HERDR_ENV gates nothing here — this process will
# never have it set. Reaching the server is the real precondition.
herdr_up() { herdr api snapshot >/dev/null 2>&1; }

# The service runs with the session's DBUS_SESSION_BUS_ADDRESS, so this reaches the
# desktop. A run on a machine without notify-send just logs.
notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a start-backlog -u "$1" "$2" "$3" >/dev/null 2>&1 || true
}

# The only proof of an `aws login` session is a call: the credentials it hands out last
# 15 minutes and are refreshed on demand, so a cache full of expired tokens says nothing
# either way. `default` reaches them through the flock in ~/.aws/config, so this never
# races an agent's own refresh.
#
# Holds the tick on a dead session and notifies — at most one notification per
# AWS_ALERT_REPEAT_MINUTES, re-armed when the session comes back.
aws_ok() {
  (( AWS_CHECK )) || return 0
  local err now last=0
  if err=$(timeout 90 aws sts get-caller-identity --profile default \
             --query Account --output text 2>&1); then
    if [[ -e "$AWS_ALERT_STAMP" ]]; then
      rm -f "$AWS_ALERT_STAMP"
      log "aws login session answers again — dispatching resumes"
      notify normal "AWS login restored" "start-backlog is dispatching again."
    fi
    return 0
  fi
  log "aws login session is dead — holding, nothing starts: $(tr '\n' ' ' <<<"$err" | cut -c1-300)"
  now=$(date +%s)
  [[ -e "$AWS_ALERT_STAMP" ]] && last=$(<"$AWS_ALERT_STAMP")
  if (( now - last >= AWS_ALERT_REPEAT_MINUTES * 60 )); then
    notify critical "AWS login expired — backlog daemon holding" \
      "No agent starts until: aws login --profile login-raw"
    printf '%s' "$now" > "$AWS_ALERT_STAMP"
  fi
  return 1
}

cooloff_excludes() {
  local cutoff=$(( $(date +%s) - COOLOFF_HOURS * 3600 ))
  awk -v c="$cutoff" -F'\t' '$2 >= c { print "--exclude"; print $1 }' "$DISPATCHED"
}

prune_dispatched() {
  local cutoff=$(( $(date +%s) - COOLOFF_HOURS * 3600 ))
  awk -v c="$cutoff" -F'\t' '$2 >= c' "$DISPATCHED" > "$DISPATCHED.new" && mv "$DISPATCHED.new" "$DISPATCHED"
}

# Release the slots held by agents that are gone. An item claimed by `hoopit-board
# start` carries no agent name — that is a Claude Code session, not a herdr pane, and
# nothing here can tell whether it is still working. Left alone.
#
# Only the `no-pr` shape is ever released. A `pr-quiet` item has an open PR: releasing it
# sends a live branch back to Backlog, where the next tick hands it to a second agent.
# Those are logged for a human to pick up, which is what `/monitor-pr` is for.
reap() {
  local live item agent age reason url
  live=$(herdr agent list 2>/dev/null |
         python3 -c 'import json,sys; print("\n".join(a["name"] for a in json.load(sys.stdin)["result"]["agents"] if a.get("name")))')
  while IFS=$'\t' read -r item agent age reason url; do
    [[ -n "${item:-}" ]] || continue
    # An agent herdr still lists is working, however quiet the item looks.
    if [[ "$agent" != "-" ]] && grep -qx -- "$agent" <<<"$live"; then continue; fi
    if [[ "$reason" == "pr-quiet" ]]; then
      local who="agent '$agent' is gone"
      [[ "$agent" == "-" ]] && who="nothing claims it"
      log "attention $item: open PR untouched for $age and $who — $url"
      continue
    fi
    # No claim marker: a human moved it, and nothing here can judge a Claude Code session.
    [[ "$agent" != "-" ]] || continue
    log "reap $item: agent '$agent' gone, claimed $age ago, no open PR"
    (( DRY )) && continue
    # Back to Ready, not Backlog: the user's yes on this item stands, and the dead agent
    # asked nothing that promotion would answer.
    hoopit-board release "${item%%#*}" "${item##*#}" --ready \
      --reason "agent \`$agent\` is no longer running and left no open PR after $age." || true
  done < <(hoopit-board stale --older-than "$STALE_HOURS" 2>/dev/null)
}

# One line per named herdr agent: <name>\t<status>\t<minutes since its transcript moved,
# or `-` when it has none>\t<live|quiet>. `working` is live however old the transcript —
# a long tool call writes nothing while it runs — and an agent with no transcript to read
# is live too, because nothing says otherwise.
agents() {
  herdr agent list 2>/dev/null | python3 -c '
import glob, json, os, sys, time
quiet_after = float(sys.argv[1])
for a in json.load(sys.stdin)["result"]["agents"]:
    if not a.get("name"):
        continue
    sid = (a.get("agent_session") or {}).get("value")
    logs = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl")) if sid else []
    age = (time.time() - max(map(os.path.getmtime, logs))) / 60 if logs else None
    live = a.get("agent_status") == "working" or age is None or age < quiet_after
    print(a["name"], a.get("agent_status") or "-", "-" if age is None else f"{age:.0f}",
          "live" if live else "quiet", sep="\t")
' "$QUIET_MINUTES"
}

# The workspace for a repo, created if there is none. Workspaces mirror repos.
workspace_for() {
  local repo_name="$1" dir="$2" id
  id=$(herdr workspace list 2>/dev/null |
       jqr "next((w['workspace_id'] for w in d['result']['workspaces'] if w['label'] == '$repo_name'), '')")
  if [[ -z "$id" ]]; then
    id=$(herdr workspace create --cwd "$dir" --label "$repo_name" --no-focus 2>/dev/null |
         jqr "d['result']['workspace']['workspace_id']")
    log "created workspace $id for $repo_name"
  fi
  printf '%s' "$id"
}

# check -> claim -> tab -> agent -> prompt, for one issue. A failure after the claim
# releases it again rather than leaving a slot held by an agent that never started.
dispatch() {
  local repo="$1" n="$2" model="$3" reff="$4" url="$5" fp="$6"
  # `-` is the no-effort sentinel: an empty TSV field would collapse against the tabs.
  [[ "$reff" == "-" ]] && reff=""
  local name="${repo##*/}" agent="gh$n" dir wsid pane
  dir="$REPOS_DIR/$name"
  [[ -d "$dir" ]] || { log "skip $repo#$n: no checkout at $dir"; return 1; }

  local verdict
  # check prints START on success and SKIP<tab>item<tab>why on rejection.
  verdict=$(hoopit-board check "$repo" "$n") || { log "skip $repo#$n: ${verdict##*$'\t'}"; return 1; }

  if (( DRY )); then
    log "dry run: would start $agent on $repo#$n ($model${reff:+/$reff}) in $dir — footprint: $fp"
    return 0
  fi

  wsid=$(workspace_for "$name" "$dir")
  [[ -n "$wsid" ]] || { log "skip $repo#$n: no workspace for $name"; return 1; }

  pane=$(herdr tab create --workspace "$wsid" --cwd "$dir" --label "$agent" --no-focus 2>/dev/null |
         jqr "d['result']['root_pane']['pane_id']")
  [[ -n "$pane" ]] || { log "skip $repo#$n: tab create failed in $wsid"; return 1; }

  hoopit-board claim "$repo" "$n" --agent "$agent" --tab "$agent" \
    --model "$model" ${reff:+--reasoning-effort "$reff"} || return 1

  if ! herdr agent start "$agent" --kind claude --pane "$pane" -- \
        -n "$agent" --permission-mode bypassPermissions --model "$model" \
        ${reff:+--effort "$reff"} >/dev/null 2>&1; then
    log "FAILED to start $agent on $repo#$n — releasing"
    hoopit-board release "$repo" "$n" --reason "the agent could not be started; the slot is free again." || true
    return 1
  fi

  local prompt="Work $repo#$n: $url

Run it with: /assess-issue $url --started

Nobody is watching this tab. If the assessment turns on a decision only the author can
make, write the question onto the issue and release the slot with
\`hoopit-board release $repo $n --reason '<why>'\` rather than waiting for an answer."
  herdr agent prompt "$agent" "$prompt" >/dev/null 2>&1 ||
    log "warning: $agent started but the opening prompt did not send"

  printf '%s\t%s\n' "$repo#$n" "$(date +%s)" >> "$DISPATCHED"
  log "dispatched $agent on $repo#$n ($model${reff:+/$reff}) — footprint: $fp"
}

tick() {
  local run="$RUN_DIR/next.json" seen="$RUN_DIR/agents.tsv" rc
  # A listing that failed says nothing about who is at work, so nothing is called quiet.
  local live=()
  if agents > "$seen"; then
    live=(--live-agents "$(awk -F'\t' '$4 == "live" { printf "%s%s", sep, $1; sep = "," }' "$seen")"
          --idle-agents "$(awk -F'\t' '$4 == "quiet" { printf "%s%s", sep, $1; sep = "," }' "$seen")")
  fi
  mapfile -t excludes < <(cooloff_excludes)
  local scope=() r
  for r in $REPOS; do scope+=(--repo "$r"); done
  hoopit-board next $TARGET ${MAX_ACTIVE:+--max-active "$MAX_ACTIVE"} \
    ${MAX_REVIEW:+--max-review "$MAX_REVIEW"} "${live[@]}" \
    "${scope[@]}" "${excludes[@]}" > "$run"
  rc=$?

  # `next` exits 1 with a full report when there is nothing to start, and 1 with nothing
  # on stdout when GitHub answered a page with a 502/504 or the query itself was rejected.
  # Only the file tells the two apart, so an unreadable one holds the tick rather than
  # crashing the loop — the next tick asks again.
  if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$run" 2>/dev/null; then
    log "board read produced no report — holding this tick"
    return 0
  fi

  python3 - "$run" "$seen" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
seen = {r[0]: r for r in (l.rstrip("\n").split("\t") for l in open(sys.argv[2])) if len(r) == 4}
def of(n, cap):
    return f"{n}" if cap is None else f"{n}/{cap}"
print(f'in_flight={of(d["in_flight"], d["target"])} active={of(d["active"], d["max_active"])} '
      f'quiet={len(d["quiet"])} review={of(d["review"], d["max_review"])} '
      f'deficit={d["deficit"]} ready={d.get("ready", "?")} backlog={d.get("backlog", "?")} '
      f'candidates={d["candidates_total"]} startable={len(d["startable"])} '
      f'blocked={len(d["blocked"])} needs_judgement={len(d.get("needs_judgement", []))} '
      f'untriaged={len(d["untriaged"])} '
      f'held={len(d["held"])} scheduled={len(d["scheduled"])} '
      f'awaiting_deploy={len(d["awaiting_deploy"])} cooloff={len(d["excluded"])} '
      f'unexamined={d["unexamined"]} blocked_by_issue={len(d["blocked_by_issue"])} '
      f'out_of_scope={len(d["out_of_scope"])} '
      f'judgement={d.get("judgement", "off")}')
for g in d["awaiting_deploy"][:5]:
    print(f'  awaiting deploy {g["repo"]}#{g["n"]} {g["priority"]}/{g["effort"]}: {g["gate"]}')
for b in d["blocked"][:5]:
    if "collides" in b:
        why = "; ".join(f'{p} held by {",".join(v)}' for p, v in b["collides"].items())
    else:
        why = "; ".join(f'{k} at {v}' for k, v in b.get("judged", {}).items())
    print(f'  blocked {b["repo"]}#{b["n"]} {b["priority"]}/{b["effort"]}: {why}')
for j in d.get("needs_judgement", [])[:5]:
    # Neither startable nor rejected: the judgement landed between the thresholds, and
    # nothing unattended may settle that. `gh-triage` step 2 reads these and settles each.
    print(f'  needs judgement {j["repo"]}#{j["n"]} {j["priority"]}/{j["effort"]}: '
          + "; ".join(f'{k} at {v}' for k, v in j.get("judged", {}).items()))
if d["no_checkout"]:
    print(f'  no checkout: {", ".join(d["no_checkout"])} — footprints there are empty')
for q in d["quiet"]:
    _, status, age, _ = seen.get(q["agent"], (None, None, None, None))
    how = (f'agent {q["agent"]} is gone' if status is None
           else f'agent {q["agent"]} is {status}, silent for {age}m')
    print(f'  quiet {q["repo"]}#{q["n"]} ({q["status"]}): {how} — holds no active slot: '
          + (", ".join(q["prs"]) or q["url"]))
if d["max_review"] is not None and d["review"] >= d["max_review"]:
    print(f'  HOLDING: Human review is at {d["review"]}/{d["max_review"]} — nothing starts '
          f'until something there merges or closes')
if d["deficit"] > 0 and not d["startable"]:
    print(f'  IDLE with {d["deficit"]} slot(s) free: {len(d["blocked"])} blocked, '
          f'{len(d["blocked_by_issue"])} blocked by an open issue, '
          f'{len(d.get("needs_judgement", []))} needing judgement, '
          f'{len(d["untriaged"])} untriaged, {len(d["held"])} held, '
          f'{len(d["scheduled"])} not yet due, {len(d["awaiting_deploy"])} awaiting '
          f'deploy, {len(d["excluded"])} in cooloff, {d["unexamined"]} unexamined'
          + (f'; nothing is Ready and {d["backlog"]} wait in Backlog for promotion'
             if not d.get("ready") and d.get("backlog") else ''))
PY
  (( rc == 0 )) || return 0

  # Fill every free slot this pass. `startable` is already mutually non-colliding, and
  # already capped at the deficit by `next`.
  local count=0
  while IFS=$'\t' read -r repo n model reff url fp; do
    dispatch "$repo" "$n" "$model" "$reff" "$url" "$fp" && (( count++ ))
  done < <(python3 - "$run" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for e in d["startable"][:d["deficit"]]:
    print("\t".join([e["repo"], str(e["n"]), e["model"], e["reasoning_effort"] or "-",
                      e["url"], ", ".join(e["footprint"]) or "(none named)"]))
PY
)
  log "filled $count slot(s)"
}

log "start-backlog daemon: target=${TARGET:-none} max_active=${MAX_ACTIVE:-none} max_review=${MAX_REVIEW:-none} quiet_after=${QUIET_MINUTES}m interval=${INTERVAL}s dry=$DRY aws_check=$AWS_CHECK repos=$REPOS"
while :; do
  if ! herdr_up; then
    log "herdr server unreachable — holding"
  elif ! aws_ok; then
    :   # aws_ok logged and notified; reaping and dispatch both wait for the session.
  else
    prune_dispatched
    # One dispatcher at a time — a second daemon, or a manual run, waits its turn
    # rather than double-claiming an issue or double-releasing a reaped one.
    exec {lockfd}>"$LOCK"
    if flock -n "$lockfd"; then
      reap
      tick
      flock -u "$lockfd"
    else
      log "tick skipped: another dispatcher holds $LOCK"
    fi
    exec {lockfd}>&-
  fi
  (( ONCE )) && break
  sleep "$INTERVAL"
done
